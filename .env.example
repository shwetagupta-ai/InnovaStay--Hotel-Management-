# Copy this file to ".env" (optional - every value has a safe default).

# Port the website listens on
PORT=3000

# Use "production" when deploying: enables Secure cookies and hides the password-reset OTP from API responses
NODE_ENV=development

# Secret used to sign login cookies (16+ characters). If empty, a random one is generated on first start
# and stored in database/.jwt_secret
JWT_SECRET=

# Where the SQLite database file lives (default: database/innovastay.db)
# DB_PATH=

# Show the 6-digit password-reset code in the API response so you can demo the flow without SMS/email.
# Defaults to true in development and false in production.
# SHOW_RESET_OTP=true

# Send Secure cookies. Defaults to true in production. Set false only if you serve production over plain http.
# COOKIE_SECURE=true

# Set true when running behind nginx / a load balancer so each visitor's real IP is read from X-Forwarded-For
# (needed for correct rate limiting). Leave false when exposed directly.
TRUST_PROXY=false

# Max API requests per minute per visitor IP (default 900)
# API_RATE_LIMIT=900

# Cluster mode (npm run start:cluster): number of worker processes (default: CPU count, max 8)
# WORKERS=4
